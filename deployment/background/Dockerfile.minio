FROM golang:1.24.8-alpine AS build
RUN apk add --no-cache git ca-certificates
WORKDIR /src
RUN git init && git remote add origin https://github.com/minio/minio.git && git fetch --depth 1 origin 7aac2a2c5b7c882e68c1ce017d8256be2feea27f && git checkout --detach FETCH_HEAD
ENV CGO_ENABLED=0 GOMAXPROCS=2 GOTOOLCHAIN=local
RUN go build -p 2 -trimpath -ldflags="-s -w" -o /out/minio .
FROM alpine:3.22
RUN apk add --no-cache ca-certificates curl && mkdir -p /data && chown 1000:1000 /data
COPY --from=build /out/minio /usr/local/bin/minio
USER 1000:1000
ENTRYPOINT ["minio"]
CMD ["server", "/data", "--console-address", ":9001"]
